generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ProjectRole {
  OWNER
  MEMBER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String?        @unique
  passwordHash  String
  name          String?
  role          UserRole       @default(USER)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  personalAccessTokens PersonalAccessToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens OAuthAccessToken[]
  oauthRefreshTokens OAuthRefreshToken[]
  tasks         Task[]
  taskReferences TaskReference[]
  subtasks      Subtask[]
  habits        Habit[]
  habitEntries  HabitEntry[]
  quickNotes    QuickNote[]
  pomodoroSessions PomodoroSession[]
  pomodoroSettings PomodoroSettings?
  timeBlockSettings TimeBlockSettings?
  journalSalt    Bytes?
  journalEntries JournalEntry[]
  journalDraft   JournalDraft?
  notes          Note[]
  noteDraft      NoteDraft?
  comments       Comment[]
  projectActivities ProjectActivity[] @relation("ProjectActivityActor")
  createdProjectResources ProjectResource[] @relation("ProjectResourceCreator")
  pushSubscriptions PushSubscription[]
  reminders      Reminder[]
  moodleAccounts MoodleAccount[]
  canvasAccounts CanvasAccount[]
  uasdAccounts UasdAccount[]
  projects       Project[]
  timeBlocks     TimeBlock[]
  taskSchedules  TaskSchedule[]
  calendarEvents CalendarEvent[]
  timeBlockExceptions TimeBlockException[]
  calendarEventExceptions CalendarEventException[]
  projectMemberships ProjectMember[] @relation("UserProjectMemberships")
  sentProjectInvitations ProjectInvitation[] @relation("UserProjectInvitations")
  createdProjectInviteLinks ProjectInviteLink[] @relation("UserCreatedProjectInviteLinks")
  assignedTasks  Task[]              @relation("TaskAssignee")
  notificationSettings NotificationSettings?
  notificationLogs NotificationLog[]
  feedback      Feedback[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
}

model Project {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  description String?
  targetDate DateTime?
  color      String      @default("#303e51")
  isDefault  Boolean     @default(false)
  weeklyTargetMinutes Int?
  tasks      Task[]
  timeBlocks TimeBlock[]
  moodleAccounts MoodleAccount[]
  canvasAccounts CanvasAccount[]
  uasdAccounts UasdAccount[]
  members    ProjectMember[]
  invitations ProjectInvitation[]
  notes      Note[]
  comments   Comment[]
  activities ProjectActivity[]
  resources  ProjectResource[]
  inviteLinks ProjectInviteLink[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User     @relation("UserProjectInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  email        String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@unique([projectId, email])
  @@index([projectId])
  @@index([email])
  @@index([invitedById])
}

model ProjectInviteLink {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("UserCreatedProjectInviteLinks", fields: [createdById], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  tokenCipher String?
  tokenIv     String?
  tokenAuthTag String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([projectId, revokedAt])
  @@index([createdById])
}

model TimeBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date      DateTime?
  recurrenceStartsAt DateTime?
  name      String?
  daysOfWeek Int[]
  startMin  Int
  endMin    Int
  isActive  Boolean  @default(true)
  repeatEveryWeeks Int       @default(1)
  repeatEndsAt     DateTime?
  remindBeforeMin  Int        @default(0)
  lastRemindNotifiedAt DateTime?
  lastStartNotifiedAt   DateTime?
  lastEndWarnNotifiedAt DateTime?
  exceptions TimeBlockException[]
  taskSchedules TaskSchedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([userId, date])
  @@index([projectId])
}

model TaskSchedule {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date        DateTime
  timeBlockId String
  timeBlock   TimeBlock  @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, taskId])
  @@index([userId, date])
  @@index([userId, timeBlockId, date])
}

model CalendarEvent {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String   @db.VarChar(200)
  date                  DateTime
  recurrenceStartsAt    DateTime?
  allDay                Boolean  @default(false)
  startMin              Int?
  endMin                Int?
  location              String?  @db.VarChar(200)
  color                 String?  @db.VarChar(20)
  recurrenceType        EventRecurrenceType?
  recurrenceInterval    Int      @default(1)
  recurrenceDaysOfWeek  Int[]    @default([])
  recurrenceDayOfMonth  Int?
  recurrenceEndsAt      DateTime?
  remindBeforeMin       Int      @default(0)
  lastRemindNotifiedAt  DateTime?
  lastStartNotifiedAt   DateTime?
  lastEndWarnNotifiedAt DateTime?
  exceptions            CalendarEventException[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, allDay, date])
}

enum EventRecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CalendarEventExceptionAction {
  skip
  move
}

model CalendarEventException {
  id        String                       @id @default(uuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     CalendarEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime
  targetDate DateTime?
  action    CalendarEventExceptionAction
  startMin  Int?
  endMin    Int?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([eventId, date])
  @@index([userId, date])
  @@index([eventId, date])
}

enum TimeBlockExceptionAction {
  skip
  move
}

model TimeBlockException {
  id        String                   @id @default(uuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId   String
  block     TimeBlock                @relation(fields: [blockId], references: [id], onDelete: Cascade)
  date      DateTime
  targetDate DateTime?
  action    TimeBlockExceptionAction
  startMin  Int?
  endMin    Int?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([blockId, date])
  @@index([userId, date])
  @@index([blockId, date])
}

model NotificationSettings {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningDigest        Boolean  @default(true)
  taskDueReminders     Boolean  @default(true)
  integrationNews      Boolean  @default(true)
  integrationErrors    Boolean  @default(true)
  timeBlockReminders   Boolean  @default(true)
  habitReminders       Boolean  @default(true)
  eventReminders       Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model NotificationLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      String
  title      String
  body       String?
  status     String
  sentCount  Int      @default(0)
  totalCount Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("notification_logs")
}

model TimeBlockSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayStartMin Int      @default(360)
  dayEndMin   Int      @default(1380)
  updatedAt   DateTime @updatedAt
}

model Task {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus   @default(PENDING)
  priority           TaskPriority @default(NORMAL)
  dueDate            DateTime?
  completedAt        DateTime?
  order              Int          @default(0)
  source             TaskSource   @default(MANUAL)
  sourceRef          String?
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  archivedAt         DateTime?
  lastDueWarnedAt    DateTime?
  recurrenceType        TaskRecurrenceType?
  recurrenceInterval    Int                 @default(1)
  recurrenceDaysOfWeek  Int[]               @default([])
  recurrenceDayOfMonth  Int?
  recurrenceEndsAt      DateTime?
  recurrenceParentId    String?
  recurrenceParent      Task?               @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceOccurrences Task[]              @relation("TaskRecurrence")
  subtasks           Subtask[]
  references         TaskReference[]
  assigneeId         String?
  assignee           User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments           Comment[]
  schedules          TaskSchedule[]
  pomodoroEstimate   Int          @default(0)
  pomodoroCount      Int          @default(0)
  pomodoroSessions   PomodoroSession[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, source, sourceRef])
  @@index([userId, recurrenceType])
  @@index([recurrenceParentId])
  @@index([assigneeId])
  @@unique([userId, source, sourceRef])
}

model TaskReference {
  id        String     @id @default(uuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  url       String
  order     Int        @default(0)
  source    TaskSource @default(MANUAL)
  sourceRef String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([taskId, source, sourceRef])
  @@index([taskId, order])
  @@index([userId])
}

enum TaskSource {
  MANUAL
  MOODLE
  CANVAS
  UASD
}

model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PomodoroPhase {
  WORK
  SHORT_BREAK
  LONG_BREAK
}

enum PomodoroSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model PomodoroSession {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  phase          PomodoroPhase
  status         PomodoroSessionStatus  @default(ACTIVE)
  plannedSec     Int
  actualSec      Int?
  cycleIndex     Int                    @default(1)
  startedAt      DateTime               @default(now())
  pausedAt       DateTime?
  totalPausedSec Int                    @default(0)
  endedAt        DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([userId, taskId])
}

model PomodoroSettings {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSec       Int      @default(1500)
  shortBreakSec Int      @default(300)
  longBreakSec  Int      @default(900)
  cyclesPerLong Int      @default(4)
  autoCycle     Boolean  @default(false)
  soundEnabled  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  frequency      HabitFrequency @default(DAILY)
  targetDays     Int            @default(7)
  daysOfWeek     Int[]          @default([])
  archived       Boolean        @default(false)
  lastRemindedAt DateTime?
  entries        HabitEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, archived])
}

model HabitEntry {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId, date])
}

enum QuickNoteStatus {
  INBOX
  ARCHIVED
}

model QuickNote {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  status    QuickNoteStatus @default(INBOX)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

model JournalEntry {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  contentCipher  Bytes
  iv             Bytes
  authTag        Bytes
  classification String?
  tags           String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

model JournalDraft {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   @default("")
  contentCipher  Bytes
  iv             Bytes
  authTag        Bytes
  classification String?
  tags           String[]
  updatedAt      DateTime @updatedAt
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String?
  tags      String[]
  pinned    Boolean   @default(false)
  collaboratorsCanEdit Boolean @default(false)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([projectId])
}

model NoteDraft {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String   @default("")
  category  String?
  tags      String[]
  pinned    Boolean  @default(false)
  projectId String?
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  body      String   @db.Text
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([authorId])
}

model ProjectActivity {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation("ProjectActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        String
  entityId    String?
  entityTitle String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId])
}

model ProjectResource {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("ProjectResourceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([createdById])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PersonalAccessToken {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String     @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([prefix])
}

model OAuthClient {
  id                    String                   @id @default(uuid())
  clientId              String                   @unique
  name                  String
  redirectUris          String[]
  allowedScopes         String[]
  tokenEndpointAuthMethod String                 @default("none")
  jwksUri               String?
  tokenEndpointAuthSigningAlg String?
  isActive              Boolean                  @default(true)
  authorizationCodes    OAuthAuthorizationCode[]
  accessTokens          OAuthAccessToken[]
  refreshTokens         OAuthRefreshToken[]
  clientAssertions      OAuthClientAssertion[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([isActive])
}

model OAuthAuthorizationCode {
  id                  String      @id @default(uuid())
  codeHash            String      @unique
  clientId            String
  client              OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  scope               String
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  resource            String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime    @default(now())

  @@index([clientId, expiresAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model OAuthAccessToken {
  id         String      @id @default(uuid())
  tokenHash  String      @unique
  familyId   String
  clientId   String
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String
  audience   String[]
  resource   String
  issuer     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique
  familyId      String
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         String
  audience      String[]
  resource      String
  issuer        String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  createdAt     DateTime    @default(now())

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model OAuthClientAssertion {
  id        String      @id @default(uuid())
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jti       String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([clientId, expiresAt])
  @@index([expiresAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model PushSubscription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String
  p256dh      String
  auth        String
  userAgent   String?
  lastErrorAt DateTime?
  disabledAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([disabledAt])
}

enum ReminderRepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskRecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
}

model Reminder {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String             @db.VarChar(200)
  body             String?
  triggerAt        DateTime
  timezone         String             @default("America/Bogota")
  repeatType       ReminderRepeatType?
  repeatInterval   Int                @default(1)
  repeatDaysOfWeek Int[]
  repeatDayOfMonth Int?
  payload          Json?
  isActive         Boolean            @default(true)
  sentAt           DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isActive, triggerAt])
  @@index([userId, isActive, triggerAt])
  @@index([userId, triggerAt])
}

model MoodleAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String
  username     String
  tokenCipher  String
  tokenIv      String
  tokenAuthTag String
  service      String   @default("moodle_mobile_app")
  enabled      Boolean  @default(true)
  lastSyncAt   DateTime?
  syncError    String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}

enum FeedbackCategory {
  BUG
  IDEA
  IMPROVEMENT
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESOLVED
}

model Feedback {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     FeedbackCategory
  message      String           @db.Text
  contactEmail String?
  status       FeedbackStatus   @default(NEW)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CanvasAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String
  username     String   @default("")
  tokenCipher  String
  tokenIv      String
  tokenAuthTag String
  enabled      Boolean  @default(true)
  lastSyncAt   DateTime?
  syncError    String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}

enum UasdSyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model UasdAccount {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          String   @default("https://app.uasd.edu.do")
  username        String
  passwordCipher  String
  passwordIv      String
  passwordAuthTag String
  period          String
  configurationVersion Int      @default(1)
  enabled         Boolean  @default(true)
  lastSyncAt      DateTime?
  nextSyncAt      DateTime @default(now())
  syncError       String?
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  syncJobs        UasdSyncJob[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
  @@index([enabled, nextSyncAt])
}

model UasdSyncJob {
  id             String           @id @default(uuid())
  accountId      String
  account        UasdAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  configurationVersion Int
  status         UasdSyncJobStatus @default(PENDING)
  reason         String           @default("scheduled")
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  availableAt    DateTime         @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  dedupeKey      String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, availableAt])
  @@index([accountId, status])
}
